<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Scoped to this solution: the org's private feed requires auth that is not
       available here, so restore resolves against nuget.org only. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
